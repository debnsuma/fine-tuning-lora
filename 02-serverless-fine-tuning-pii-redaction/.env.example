# Crusoe Inference API key.
# https://console.crusoecloud.com/security/inference-api-keys
CRUSOE_API_KEY=your-crusoe-api-key-here

# Hugging Face access token, needed to download the gated gretelai/synthetic_pii_finance_multilingual dataset without rate-limit warnings.
# https://huggingface.co/settings/tokens
HF_TOKEN=your-hf-token-here
